[Unit]
Description=rsync mirror of the reprobuild binary cache to the Windows-side backup
Documentation=https://github.com/metacraft-labs/reprobuild-specs/blob/latest/Binary-Caches.md
After=repro-binary-cache.service
Requires=repro-binary-cache.service

[Service]
Type=oneshot
User=reprocache
Group=reprocache
# Mirror /var/lib/repro-binary-cache/{store,manifests,index,trust}/ and
# server-pubkey.hex to a Windows-side dated subdir under
# /mnt/d/metacraft/repro-binary-cache-backup/.
#
# Rotation policy: the deployed snapshot helper keeps the last 7 daily
# snapshots and unlinks older ones. A staged directory prevents a partial
# rsync from replacing the current day's complete snapshot.
ExecStart=/usr/local/bin/repro-binary-cache-rsync-snapshot
WorkingDirectory=/var/lib/repro-binary-cache
