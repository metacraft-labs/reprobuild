version       = "0.1.0"
author        = "Metacraft Labs"
description   = "Working-tree snapshot manifests (git-tree-sha1 bound): capture, verification, and worktree materialization through a copy-on-write worktree pool for remote goals (Distributed-Execution M7, M1)"
license       = "Apache-2.0"
srcDir        = "src"

requires "nim >= 2.2.0"
requires "repro_core >= 0.1.0"
requires "repro_workspace_manifests >= 0.1.0"
