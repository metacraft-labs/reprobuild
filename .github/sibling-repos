# Cross-repo siblings the dev-shell CI jobs (lint, test) clone adjacent to this
# checkout so config.nims's sibling detection can resolve them. The shared
# `clone-siblings` action (run by setup-dev-env) reads this file.
#
# `name=ref` clones the ref directly; plain `name` resolves the revision from
# the per-commit workspace lock in metacraft-manifests. reprobuild is not yet
# integrated into the lock contract, so pin the mainline branch explicitly.
#
# These carry codetracer's canonical incremental test engine
# (src/ct_test/incremental) and the trace-format-nim CTFS reader it imports,
# reached through ct_incremental_adapter (the engine-free seam). One-way
# dependency: reprobuild -> codetracer.
codetracer=dev
codetracer-trace-format-nim=dev

# The two siblings CodeTracer's own build REQUIRES, as opposed to the ones its
# Nim `--path` merely prefers. `scripts/build-once.sh` refuses to start without
# them and names them, which is the failure this declaration exists to prevent:
#
#   * codetracer-trace-format — five `path = "../../../codetracer-trace-format/
#     ..."` dependencies in `src/db-backend/Cargo.toml`. cargo cannot parse the
#     manifest at all without it.
#   * codetracer-native-recorder — `src/db-backend/build.rs` compiles the Nim
#     MCR emulator out of `ct_emulator/` and links it; without it the db-backend
#     link fails with 81 undefined `mcr*` symbols.
#
# Neither appears in CodeTracer's committed `repro.lock`, so `repro develop
# --all` cannot supply them: they are not dependency-graph nodes, they are
# adjacent source trees the build reads directly. They have to be declared here
# or they are not cloned at all.
#
# They were missing, and the Test job only passed on hosts where an earlier job
# happened to have left them behind: mcl-001/003/005 passed, mcl-002/004 failed
# with "Cannot start the CodeTracer build: 2 required sibling repo(s) are
# missing". A check whose outcome depends on which runner picked up the job is
# not a check.
#
# Refs match the inputs CodeTracer's own `flake.nix` pins: trace-format at
# `main`, native-recorder at `dev` (db-backend's emulator FFI contract moves
# with recorder dev; `stable` is only the last released snapshot).
codetracer-trace-format=main
codetracer-native-recorder=dev

# codetracer's `ct` binary (built via codetracer/reprobuild.nim's `ct` target so
# ct_incremental_adapter can exec `ct test --incremental`) imports the IsoNim UI
# stack and the shared Nim agent libs, so its Nim compile needs these adjacent on
# the --path. The `ct` build path (L2 CI-PROVISION-FROM-LOCK) no longer relies on
# these branch pins for its dep set: it runs `repro develop --all --reset` in
# codetracer, which provisions isonim + the nim-* libs at the revisions pinned in
# codetracer's committed `repro.lock`. `--reset` RECONCILES these `=dev`
# pre-clones to the lock in place: when a clone matches the locked revision it is
# adopted, and when it has drifted off the lock (the usual case, since `=dev`
# tracks a moving tip) it is force-reset to the locked SHA rather than refused.
# So these `=dev` entries no longer have to be kept in lock-step with codetracer's
# lock for the ct build to stay green — the drift is reconciled at build time.
# They stay because reprobuild's OWN e2e tests (codetracer-subset, watch) still
# consume the siblings adjacent on the --path. reprobuild only ever execs the
# resulting `ct`.
isonim=dev
isonim-gpui=dev
isonim-tui=dev
nim-acp=dev
nim-agent-harbor=dev
nim-agents=dev
nim-everywhere=dev
nim-pty=dev
nim-termctl=dev

# The TestRunner cross-cutting contract (Nim package `repro_test_adapters`)
# lives in this standalone repo; `repro_dsl_stdlib` re-exports it, so the
# recipe-interface extractor that reads codetracer/reprobuild.nim needs it on
# the --path as `../reprobuild-test-adapters/src`. Mainline branch is `main`.
reprobuild-test-adapters=main
reprobuild-ct-test-runner=main


# codetracer's incremental test engine (src/ct_test/incremental/io_mon_capture.nim
# etc.) imports `io_mon` and `stackable_hooks/propagation`; codetracer's .envrc
# wires IO_MON_SRC / NIM_STACKABLE_HOOKS_SRC from the ../io-mon and
# ../nim-stackable-hooks siblings. io-mon is pinned to the hardened revision
# used by this retirement campaign.
#
# 75de6f2 is 8a55c4f + ONE cherry-picked commit touching only
# `scripts/build_shim.sh` (io-mon branch `pin/hardened-platform-detect`). It is
# deliberately not io-mon's dev tip: dev carries five further commits to
# dep_queue / writer / the macOS sandbox-tools lifecycle, and moving the pin
# would change the io-mon RUNTIME this campaign is hardening against. The
# cherry-pick changes a build script only.
#
# Why it is needed: at 8a55c4f, build_shim.sh dispatches on `$(uname -s)`, and
# inside reprobuild's MONITORED `repro build` action on macOS that expands to
# the empty string — the v0.1.3 release and the 30608858466 validation run both
# died on `unsupported platform  for the io-mon shim` (note the doubled space)
# minutes after the same script had succeeded outside the engine in the same
# job. The cherry-pick resolves the platform from `$OSTYPE`/`$HOSTTYPE` (bash
# builtins — no fork for a monitoring shim to interpose) with uname as fallback.
io-mon=75de6f292f3df7303662915988874ac310012406
nim-stackable-hooks=c6cf6ad1ac95201288825970b6ca53f630ea8996
runquota=dev
nim-shm-queue=08d87d26067568e980f4356c4abcf2a0d841a310
nim-shm-gset=8a9f2f13beb24ab7949ff93c14fb34ae753bbe48
repo-workspaces=main



