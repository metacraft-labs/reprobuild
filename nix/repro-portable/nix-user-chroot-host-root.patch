+// Every top-level entry of the host root except /nix, which the sandbox
+// replaces. A fixed list here is what hid /bin (and with it /bin/sh), /lib,
+// /lib64, /sbin, /opt, /srv, /mnt and /media from everything run inside.
+static void add_host_root(list<struct DirMapping> &dirMappings) {
+  DIR *root = opendir("/");
+  if (!root) {
+    err_exit("opendir(/)");
+  }
+  struct dirent *entry;
+  while ((entry = readdir(root)) != NULL) {
+    string name = entry->d_name;
+    if (name == "." || name == ".." || name == "nix") continue;
+    dirMappings.push_back({ "/" + name, name, true });
+  }
+  closedir(root);
+}
 
