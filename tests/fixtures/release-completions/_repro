#compdef repro
# zsh completion for repro, generated by clispec.
# Install: save this as _repro in a directory of $fpath (before compinit
# runs), or source <(repro completion zsh) after compinit in ~/.zshrc.
_clispec_complete_repro() {
    local reply line value described=0
    local -a lines plain plainShown open openShown
    # The words after the program name, up to and including the one being
    # completed, unquoted; the answer is one `value<TAB>description` per line.
    reply="$(command repro __complete zsh "${(@Q)words[2,CURRENT]}" 2>/dev/null)" || return 1
    lines=("${(@f)reply}")
    for line in "${lines[@]}"; do
        [[ -z $line ]] && continue
        value="${line%%$'\t'*}"
        if [[ $line == *$'\t'* ]]; then
            described=1
            line="$value  -- ${line#*$'\t'}"
        fi
        # A `--flag=` or a directory is completed further, not ended.
        if [[ $value == *[=/] ]]; then
            open+=("$value"); openShown+=("$line")
        else
            plain+=("$value"); plainShown+=("$line")
        fi
    done
    local -a layout
    (( described )) && layout=(-l)
    (( ${#plain} )) && compadd "${layout[@]}" -d plainShown -a plain
    (( ${#open} )) && compadd "${layout[@]}" -S '' -d openShown -a open
    return 0
}
if [[ "${zsh_eval_context[-1]}" == loadautofunc ]]; then
    # Autoloaded from $fpath as _repro (compinit): this body runs again on
    # every later call, outside the autoload, so register the function
    # itself now and complete this time.
    compdef _clispec_complete_repro repro
    _clispec_complete_repro "$@"
else
    compdef _clispec_complete_repro repro
fi
