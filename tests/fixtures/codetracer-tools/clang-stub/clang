#!/bin/sh
# reprobuild-codetracer-compiler-stand-in-v1
# A version-answering stand-in, never a real compiler: it writes no output.
# The marker above is what `gcc-proxy.c` looks for so that it never forwards
# a compile here.
set -eu
case "${1:-}" in
  --version|-v) echo 'clang fixture 1.0.0'; exit 0 ;;
  *) exit 0 ;;
esac
