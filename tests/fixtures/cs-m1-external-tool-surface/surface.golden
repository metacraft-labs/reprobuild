    arg name="output" nimType="string" kind=cpkFlag role=carOutput format=cafSeparate placement=capAfterSubcommand repeated=false position=0 alias="-o" value="out.bin"
    arg name="sources" nimType="seq[string]" kind=cpkPositional role=carInput format=cafSeparate placement=capAfterSubcommand repeated=false position=1 alias="" value="a.c\x1Fb.c"
