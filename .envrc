# shellcheck shell=bash
# flake-overrides plugin (blocksense-network/direnv-nix-flake-overrides):
# prefer a sibling checkout of the plugin (workspace dev — always current),
# else the pinned published copy (CI / standalone clones).
_fo_local="../direnv-nix-flake-overrides/plugin/flake-overrides.bash"
if [[ -f "$_fo_local" ]]; then
	watch_file "$_fo_local"
	source "$_fo_local"
else
	# Pin the plugin revision that IMPLEMENTS the auto-override used below.
	# `NIX_FLAKE_OVERRIDE_AUTO` was added to the plugin after the previous pin
	# (sha256-bqkWqI8U…): that older copy defines `flake_override_args_quoted`
	# but knows only `NIX_FLAKE_OVERRIDE_INPUTS`/`_FLAKES`, so it silently
	# emitted no `--override-input` at all and every sibling checkout was
	# ignored in favour of the flake.lock pin. `source_url` resolves from its
	# content hash, so a stale pin here is not merely old — it is a different
	# program with no auto-override in it. Keep this in step with the rest of
	# the workspace (runquota, isonim, nim-everywhere, reprobuild-specs all pin
	# this revision); a sibling `../direnv-nix-flake-overrides` checkout, when
	# present, takes precedence and sidesteps the pin entirely.
	source_url "https://direnv-flake-overrides.blocksense.network/plugin" \
		"sha256-BTxlsheP/7/FQw9IBPGFc6zYTl5S2qdAAt3EUqfkbjI="
fi
unset _fo_local

watch_file scripts/lib/dev_shell_overrides.sh
source scripts/lib/dev_shell_overrides.sh

dotenv_if_exists .env
watch_file .env

# nix-direnv's `use flake` registers flake.nix/flake.lock as watched files only
# when the flake expression names a DIRECTORY. Ours carries a query string
# (`.?submodules=1`), so `[[ -d $flake_expr ]]` is false and neither file is
# watched — an edit to flake.nix left the cached dev shell in place and the
# shell kept serving the previous environment until something else invalidated
# it. Watch them here, where the expression is known.
watch_file flake.nix
watch_file flake.lock

# Full-auto local overrides: every flake input that has a same-named sibling
# checkout next to this repo is overridden to that checkout (honouring the
# metacraft `-src` suffix convention, e.g. runquota-src → ../runquota,
# ct-test-src → ../ct-test). The flake then builds the client AND the runquotad
# daemon from the local source. Pin or exclude an input by hand in .env via
# NIX_FLAKE_OVERRIDE_INPUTS if needed.
export NIX_FLAKE_OVERRIDE_AUTO=1
export NIX_FLAKE_OVERRIDE_AUTO_STRIP_SUFFIXES=-src

# Every override knob this file offers must be one the loaded plugin actually
# acts on. The pin above is the current answer; this is what keeps it an
# answer. The check does not read a version string — it makes the plugin
# PERFORM each knob against a throwaway probe tree and looks for the
# `--override-input` that must come out, so a plugin that renames its
# internals still passes and a plugin that quietly drops the auto arm still
# fails. It probes the knobs this file OFFERS whether or not they are set,
# which is the difference between finding a stale pin the day it goes stale
# and finding it the day somebody first relies on it.
#
# On failure this REFUSES. A dev shell built from inputs other than the ones
# named here is worse than no dev shell, because it looks exactly like a
# working one — that is precisely how the stale pin above survived: the
# variable was read by nothing and nothing said so.
if ! dev_shell_guard_override_knobs \
	NIX_FLAKE_OVERRIDE_AUTO \
	NIX_FLAKE_OVERRIDE_AUTO_STRIP_SUFFIXES \
	NIX_FLAKE_OVERRIDE_SIBLINGS \
	NIX_FLAKE_OVERRIDE_SIBLINGS_ROOT \
	NIX_FLAKE_OVERRIDE_INPUTS \
	NIX_FLAKE_OVERRIDE_FLAKES; then
	exit 1
fi

_fo_args="$(flake_override_args_quoted)"

# Record what the overridden sources are AT RIGHT NOW and hand the record to
# direnv as a watched file.
#
# The two `watch_file` lines above put flake.nix and flake.lock back in the
# watch set. Neither says anything about the sibling working trees the auto
# arm resolves to: `--override-input runquota-src path:../runquota` makes that
# tree a build input, and no file nix-direnv watches changes when it moves. So
# the cached profile keeps exporting the store path the tree was copied to at
# write time, for as long as the profile survives — which is how RUNQUOTA_SRC
# came to name a snapshot fifteen days and fifty-nine commits behind the
# working tree it was taken from.
#
# The fingerprint is the missing member of the watch set. It is rewritten only
# when an overridden source actually moved, so its mtime is exactly the signal
# nix-direnv's staleness check needs — and no signal at all when nothing moved,
# which matters just as much: a file that churned on every load would rebuild
# the shell on every directory entry.
_fo_fingerprint=".direnv/flake-override-sources.fingerprint"
dev_shell_write_fingerprint "$_fo_fingerprint" \
	"$(printf '%s' "$_fo_args" | dev_shell_override_path_pairs_from_args |
		dev_shell_render_fingerprint)"
watch_file "$_fo_fingerprint"
unset _fo_fingerprint

eval "use flake '.?submodules=1' $_fo_args"
unset _fo_args
