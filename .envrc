# shellcheck shell=bash
# flake-overrides plugin (blocksense-network/direnv-nix-flake-overrides):
# prefer a sibling checkout of the plugin (workspace dev — always current),
# else the pinned published copy (CI / standalone clones).
_fo_local="../direnv-nix-flake-overrides/plugin/flake-overrides.bash"
if [[ -f "$_fo_local" ]]; then
	watch_file "$_fo_local"
	source "$_fo_local"
else
	# Pin the plugin revision that IMPLEMENTS the auto-override used below.
	# `NIX_FLAKE_OVERRIDE_AUTO` was added to the plugin after the previous pin
	# (sha256-bqkWqI8U…): that older copy defines `flake_override_args_quoted`
	# but knows only `NIX_FLAKE_OVERRIDE_INPUTS`/`_FLAKES`, so it silently
	# emitted no `--override-input` at all and every sibling checkout was
	# ignored in favour of the flake.lock pin. `source_url` resolves from its
	# content hash, so a stale pin here is not merely old — it is a different
	# program with no auto-override in it. Keep this in step with the rest of
	# the workspace (runquota, isonim, nim-everywhere, reprobuild-specs all pin
	# this revision); a sibling `../direnv-nix-flake-overrides` checkout, when
	# present, takes precedence and sidesteps the pin entirely.
	source_url "https://direnv-flake-overrides.blocksense.network/plugin" \
		"sha256-BTxlsheP/7/FQw9IBPGFc6zYTl5S2qdAAt3EUqfkbjI="
fi
unset _fo_local

dotenv_if_exists .env
watch_file .env

# nix-direnv's `use flake` registers flake.nix/flake.lock as watched files only
# when the flake expression names a DIRECTORY. Ours carries a query string
# (`.?submodules=1`), so `[[ -d $flake_expr ]]` is false and neither file is
# watched — an edit to flake.nix left the cached dev shell in place and the
# shell kept serving the previous environment until something else invalidated
# it. Watch them here, where the expression is known.
watch_file flake.nix
watch_file flake.lock

# Full-auto local overrides: every flake input that has a same-named sibling
# checkout next to this repo is overridden to that checkout (honouring the
# metacraft `-src` suffix convention, e.g. runquota-src → ../runquota,
# ct-test-src → ../ct-test). The flake then builds the client AND the runquotad
# daemon from the local source. Pin or exclude an input by hand in .env via
# NIX_FLAKE_OVERRIDE_INPUTS if needed.
export NIX_FLAKE_OVERRIDE_AUTO=1
export NIX_FLAKE_OVERRIDE_AUTO_STRIP_SUFFIXES=-src
eval "use flake '.?submodules=1' $(flake_override_args_quoted)"
